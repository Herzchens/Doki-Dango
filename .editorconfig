root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonl}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
indent_size = 4

[*.rs]
indent_size = 4

[*.gradle]
indent_size = 4

[*.kt]
indent_size = 4

[*.xml]
indent_size = 4
